# Backend API host (without /api/v1 prefix, since clients append it)
VITE_API_BASE_URL=http://localhost:8080

# Lưu ý: Cấu hình Cloudinary (CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET)
# được cấu hình tập trung an toàn tại file .env của máy chủ Backend (CampusHub-Backend/.env).
# Frontend tải ảnh lên thông qua API Backend: POST /api/v1/upload/image.
