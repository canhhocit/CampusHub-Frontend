# Backend API host (without /api/v1 prefix, since clients append it)
VITE_API_BASE_URL=http://localhost:8080

# Cloudinary Direct Upload Configuration
# Đăng ký tài khoản Cloudinary miễn phí tại https://cloudinary.com
# Tạo Unsigned Upload Preset tại Settings > Upload > Upload presets > Add upload preset (Signing Mode: Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
